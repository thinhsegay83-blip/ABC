[gd_resource type="Resource" script_class="TutorialHintSet" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/tutorial_hint_set.gd" id="1_cfg"]

[resource]
script = ExtResource("1_cfg")
hints = Array[Dictionary]([{"id": "hanh_dong", "text": "Q: mở menu hành động — đi tới nơi khác, vào học, làm thêm, ăn uống, ngủ, nói chuyện."}, {"id": "hoi_thoai", "text": "Hội thoại: Space/Enter để đọc tiếp · giữ Ctrl để tua câu đã đọc · T tự chạy · L xem lịch sử."}, {"id": "dien_thoai", "text": "Tab: mở điện thoại — tin nhắn, ví, lịch học, nhiệm vụ, danh bạ, túi đồ."}, {"id": "tkb", "text": "Thời khóa biểu: điện thoại → Lịch học, hoặc bàn học ở phòng KTX."}, {"id": "di_hoc", "text": "Đang có tiết! Q → Giảng đường → Vào học. Vắng sẽ bị trừ điểm chuyên cần."}, {"id": "lam_them", "text": "Làm thêm tối đa 2 ca mỗi ngày. Mỗi ca tốn 1 khung giờ và Thể lực."}, {"id": "an_uong", "text": "Đói thấp thì học kém và Thể lực tụt nhanh. Mua đồ ăn ở quán hoặc máy bán nước KTX."}, {"id": "ngu", "text": "Tối/Đêm: về phòng KTX → Đi ngủ để hồi Thể lực và Sanity. Ngủ từ Tối hồi nhiều hơn."}, {"id": "tong_ket", "text": "Cuối mỗi ngày có bảng tổng kết thu, chi và chỉ số. Đầu ngày game tự lưu."}, {"id": "hoc_phi", "text": "Học phí HK1: 16.000.000 đ, hạn hết Chủ Nhật tuần 2. Đóng ở máy tại giảng đường hoặc ví trong điện thoại."}, {"id": "tui_do", "text": "I: mở túi đồ. Đồ ăn mang về có thể dùng bất cứ lúc nào."}, {"id": "radar", "text": "Điện thoại nhiễu sóng = có gì đó lạ ở gần. Mở điện thoại → Radar để xem."}, {"id": "goi_y", "text": "Bí quá thì nhấn G để suy nghĩ. Trí tuệ càng cao, gợi ý càng rõ."}])
